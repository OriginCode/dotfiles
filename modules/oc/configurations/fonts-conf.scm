(define-module (oc configurations fonts-conf)
  #:export (%custom-fonts-packages
            %custom-fonts-configuration))

(define %custom-fonts-packages
  (list
      "font-iosevka"
      "font-sarasa-gothic"
      "font-google-noto"
      "font-google-noto-emoji"
      "font-google-noto-sans-cjk"
      "font-google-noto-serif-cjk"
      ))

(define %custom-fonts-configuration
